<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- mantiene gli appender/pattern di default di Spring Boot (incluso logging.pattern.console con traceId) -->
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <!-- log di audit strutturato (JSON, una riga per evento), su file separato dal log applicativo -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/audit.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- additivity=false: gli eventi di audit NON finiscono anche nel log applicativo/console -->
    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>
</configuration>
