# Copia in `.env` (che non e' versionato) e riempi i valori.
# Il file `.env` viene letto automaticamente da `docker compose`.

# --- Database ---------------------------------------------------------------------
# application.properties non ha default per queste tre: senza, il backend non parte.
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# --- Keycloak ---------------------------------------------------------------------
# Indirizzo con cui i client raggiungono Keycloak. Fissa l'issuer dei token
# (KC_HOSTNAME_URL) e, di conseguenza, cio' che il backend si aspetta nel claim 'iss'.
#
# Deve essere raggiungibile da TUTTI i client, telefono compreso. Con
# `adb reverse tcp:8090 tcp:8090` va bene localhost; se invece il telefono passa dalla
# rete locale, metti qui l'IP della macchina di sviluppo e lo STESSO valore in
# travelApp_frontEnd/local.properties (chiave `keycloak.base.url`).
KEYCLOAK_PUBLIC_URL=http://localhost:8090

# Client secret del service account `travelapp-registration`, usato solo dalla
# registrazione self-service. Si copia da: console Keycloak -> Clients ->
# travelapp-registration -> Credentials. Nel file di import e' mascherato (`**********`),
# quindi su un realm ricreato da zero va rigenerato e riportato qui.
# Se manca, l'applicazione parte lo stesso e solo POST /api/auth/registrazione da' 503.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# --- Immagini caricate dagli utenti -----------------------------------------------
# Di default i file stanno sul disco locale (app.storage.immagini.tipo=filesystem),
# nella cartella `storage-immagini/` del repo: sia con `docker compose` sia lanciando
# il backend dall'IDE. Non serve configurare nulla, e chi clona il repo puo' caricare
# e rivedere le proprie immagini subito.
#
# Attenzione se il DB_URL qui sopra punta a un database CONDIVISO fra piu' macchine:
# il database contiene i riferimenti alle immagini, ma i byte restano sul disco di
# chi le ha caricate. Le copertine caricate da un collega risulteranno quindi 404
# sulla tua macchina (riquadro vuoto), pur essendo l'itinerario visibile.
#
# Per condividerle davvero serve uno storage comune: imposta APP_STORAGE_IMMAGINI_TIPO=s3
# e le credenziali S3/R2 (vedi application.properties, sezione object storage esterno).
#APP_STORAGE_IMMAGINI_TIPO=s3
#APP_STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#APP_STORAGE_S3_BUCKET=
#APP_STORAGE_S3_ACCESS_KEY_ID=
#APP_STORAGE_S3_SECRET_ACCESS_KEY=
