<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante applicata SOLO alla build di debug (`app/src/debug/`): Gradle la sostituisce a
  quella di `main/` quando si compila il debug, e non finisce nell'APK di release.

  Qui il traffico in chiaro e' permesso verso qualunque host. Non e' una scorciatoia: gli
  indirizzi di sviluppo ora arrivano da `local.properties` (vedi `build.gradle.kts`), quindi
  non sono piu' noti a build time e non possono essere elencati uno per uno. L'elenco fisso
  era anche la causa di un bel po' di tempo perso: bastava cambiare rete perche' l'IP nuovo
  non fosse in lista e l'app fallisse le connessioni senza un errore che lo dicesse.

  La build di release resta soggetta a `main/res/xml/network_security_config.xml`, che di
  cleartext non ne permette affatto.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
