<?xml version="1.0" encoding="utf-8"?>
<!--
  Da Android 9 il traffico in chiaro è bloccato per impostazione predefinita, ed è giusto
  così: il backend di produzione parla HTTPS (vedi il profilo `prod`, che rifiuta un issuer
  non HTTPS all'avvio).

  L'eccezione qui sotto è ristretta ai soli indirizzi del backend di sviluppo:
  `10.0.2.2` è l'alias con cui l'emulatore raggiunge il `localhost` della macchina che lo
  ospita. Un `usesCleartextTraffic="true"` sull'application avrebbe aperto il traffico in
  chiaro verso *qualunque* host, anche in release.
    Permette il traffico HTTP in chiaro solo verso 10.0.2.2 (l'host della macchina
    dev visto dall'emulatore Android): li' girano Keycloak e il backend in sviluppo,
    entrambi senza HTTPS. Tutto il resto del traffico dell'app resta soggetto al
    default di Android (solo HTTPS).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.51</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- macchina di sviluppo sulla rete locale, per le prove su telefono fisico:
             deve restare allineato a ApiClient.BASE_URL -->
        <domain includeSubdomains="false">10.145.178.54</domain>
    </domain-config>
</network-security-config>
